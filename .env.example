# 结构化默认配置在 config/default.toml；这里仅放本机或部署环境覆盖项。
# 默认仅允许本机访问；确认公司网络策略后才改为 0.0.0.0。
# 覆盖网站监听地址。
APP_HOST=127.0.0.1
# 覆盖网站监听端口。
APP_PORT=6324
# 覆盖 SQLite 数据库地址。
DATABASE_URL=sqlite://data/app.db?mode=rwc
# 覆盖头像上传目录。
AVATAR_DIR=data/avatars
# 覆盖会话 Cookie 的 Secure 标记；HTTPS 部署时改为 true。
COOKIE_SECURE=false
# 覆盖日志级别。
RUST_LOG=demo0=debug,tower_http=info

# 可选：覆盖页面时间展示时区；中国时间使用 8。
# 覆盖页面展示时间使用的 UTC 小时偏移。
# DISPLAY_UTC_OFFSET_HOURS=8

# 可选：覆盖公共留言板配置。
# 覆盖公共留言保留天数。
# MESSAGE_RETENTION_DAYS=5
# 覆盖每个用户在保留窗口内最多可发布的留言数量。
# MESSAGE_LIMIT_PER_USER=5
# 覆盖单条留言最大可见字符数。
# MESSAGE_MAX_LENGTH=300
# 覆盖公共留言板页面最多展示的留言数量。
# MESSAGE_PAGE_SIZE=30
# 覆盖首页公共留言预览最多展示的留言数量。
# MESSAGE_HOME_PREVIEW_LIMIT=5
# 覆盖后台自动清理过期留言的间隔小时数。
# MESSAGE_CLEANUP_INTERVAL_HOURS=6

# 可选：覆盖 Meme 展示墙配置。
# 覆盖 Meme 图片和 GIF 的存储目录。
# MEME_DIR=data/memes
# 覆盖单个 Meme 上传最大体积，单位为字节。
# MEME_MAX_UPLOAD_BYTES=3145728
# 覆盖 Meme 图片允许的最大宽高。
# MEME_MAX_DIMENSION=3000
# 覆盖 GIF 允许的最大帧数。
# MEME_MAX_GIF_FRAMES=120
# 覆盖 GIF 解码后的最大总像素数。
# MEME_MAX_DECODED_PIXELS=50000000
# 覆盖 Meme 展示墙每页最多返回数量。
# MEME_PAGE_SIZE=20
# 覆盖个人资料页 Meme 管理列表每页最多展示数量。
# MEME_PROFILE_PAGE_SIZE=12
# 覆盖首页 Meme 预览最多展示数量。
# MEME_HOME_PREVIEW_LIMIT=6
# 覆盖 Meme 展示墙最多展示的热门标签数量。
# MEME_POPULAR_TAG_LIMIT=10
# 覆盖每个 Meme 最多可绑定的标签数量。
# MEME_MAX_TAGS_PER_MEME=5
# 覆盖单个标签最大可见字符数。
# MEME_MAX_TAG_LENGTH=20
# 覆盖 Meme 标题最大可见字符数。
# MEME_MAX_TITLE_LENGTH=60
# 覆盖 Meme 首次审核通过时是否发放货币奖励。
# MEME_APPROVAL_REWARD_ENABLED=true
# 覆盖每个 Meme 首次通过时发放的整数货币数量。
# MEME_APPROVAL_REWARD_AMOUNT=2

# 可选：覆盖连载小说配置。
# 覆盖首页小说页签最多展示的最近更新章节数量。
# NOVEL_HOME_PREVIEW_LIMIT=5
# 覆盖单章 Markdown 最大上传体积，单位字节。
# NOVEL_CHAPTER_MAX_UPLOAD_BYTES=262144
# 覆盖小说标题最大可见字符数。
# NOVEL_MAX_TITLE_LENGTH=60
# 覆盖章节标题最大可见字符数。
# NOVEL_MAX_CHAPTER_TITLE_LENGTH=80
# 覆盖单条章节匿名评论最大可见字符数。
# NOVEL_CHAPTER_COMMENT_MAX_LENGTH=300
# 覆盖单个章节页面默认展示的评论数量。
# NOVEL_CHAPTER_COMMENT_PAGE_SIZE=50

# 可选：覆盖服务器更新记录配置。
# 更新记录 TOML 文件路径。
# UPDATES_FILE=content/updates.toml
# 首页更新记录最多展示条数。
# UPDATES_HOME_PREVIEW_LIMIT=3

# 可选：覆盖货币系统配置。
# 页面展示的货币名称。
# CURRENCY_NAME=洲币
# 页面展示的货币符号。
# CURRENCY_SYMBOL=🪙
# 货币流水页每页最多展示记录数。
# CURRENCY_LOG_PAGE_SIZE=30
# 货币管理页展示所有用户最近流水的数量。
# CURRENCY_ADMIN_RECENT_LOG_LIMIT=10
# 超级管理员单次增减货币的最大绝对值。
# CURRENCY_MAX_ADMIN_ADJUST_AMOUNT=99999
# 管理员搜索用户时最多返回用户数。
# CURRENCY_ADMIN_USER_SEARCH_LIMIT=20
# 管理员调整货币时备注的最大字符数。
# CURRENCY_MAX_NOTE_LENGTH=200

# 可选：覆盖每周签到配置。
# 是否开启每周签到功能。
# CHECK_IN_ENABLED=true
# 每周签到成功后发放的整数货币数量。
# CHECK_IN_REWARD_AMOUNT=1

# 可选：覆盖商城与兑换码配置。
# 是否开启商城。
# SHOP_ENABLED=true
# 商品目录 TOML 文件路径。
# SHOP_PRODUCTS_FILE=content/shop.toml
# 商品图标静态文件目录。
# SHOP_ICON_DIR=static/shop/products
# 商城商品列表每页展示数量。
# SHOP_PAGE_SIZE=12
# 用户兑换券列表每页展示数量。
# SHOP_VOUCHER_PAGE_SIZE=20
# 管理员备注允许的最大可见字符数。
# SHOP_ADMIN_NOTE_MAX_LENGTH=200
# 单个来源在兑换码查询窗口内允许的最大尝试次数。
# SHOP_TOKEN_LOOKUP_MAX_ATTEMPTS=20
# 兑换码查询限流窗口，单位为秒。
# SHOP_TOKEN_LOOKUP_WINDOW_SECONDS=60
# 商品图标文件最大体积，单位为字节。
# SHOP_ICON_MAX_BYTES=262144
# 商品图标允许的最大宽度或高度，单位为像素。
# SHOP_ICON_MAX_DIMENSION=1024
