# 结构化默认配置在 config/default.toml；这里仅放本机或部署环境覆盖项。
# 默认仅允许本机访问；确认公司网络策略后才改为 0.0.0.0。
# 覆盖网站监听地址。
APP_HOST=127.0.0.1
# 覆盖网站监听端口。
APP_PORT=6324
# 覆盖 SQLite 数据库地址。
DATABASE_URL=sqlite://data/app.db?mode=rwc
# 覆盖头像上传目录。
AVATAR_DIR=data/avatars
# 覆盖会话 Cookie 的 Secure 标记；HTTPS 部署时改为 true。
COOKIE_SECURE=false
# 覆盖日志级别。
RUST_LOG=demo0=debug,tower_http=info

# 可选：覆盖页面时间展示时区；中国时间使用 8。
# 覆盖页面展示时间使用的 UTC 小时偏移。
# DISPLAY_UTC_OFFSET_HOURS=8

# 可选：覆盖公共留言板配置。
# 覆盖公共留言保留天数。
# MESSAGE_RETENTION_DAYS=5
# 覆盖每个用户在保留窗口内最多可发布的留言数量。
# MESSAGE_LIMIT_PER_USER=5
# 覆盖单条留言最大可见字符数。
# MESSAGE_MAX_LENGTH=300
# 覆盖公共留言板页面最多展示的留言数量。
# MESSAGE_PAGE_SIZE=30
# 覆盖首页公共留言预览最多展示的留言数量。
# MESSAGE_HOME_PREVIEW_LIMIT=5
# 覆盖后台自动清理过期留言的间隔小时数。
# MESSAGE_CLEANUP_INTERVAL_HOURS=6

# 可选：覆盖 Meme 展示墙配置。
# 覆盖 Meme 图片和 GIF 的存储目录。
# MEME_DIR=data/memes
# 覆盖单个 Meme 上传最大体积，单位为字节。
# MEME_MAX_UPLOAD_BYTES=5242880
# 覆盖 Meme 图片允许的最大宽高。
# MEME_MAX_DIMENSION=3000
# 覆盖 GIF 允许的最大帧数。
# MEME_MAX_GIF_FRAMES=120
# 覆盖 Meme 展示墙每页最多返回数量。
# MEME_PAGE_SIZE=20
# 覆盖首页 Meme 预览最多展示数量。
# MEME_HOME_PREVIEW_LIMIT=6
# 覆盖每个 Meme 最多可绑定的标签数量。
# MEME_MAX_TAGS_PER_MEME=5
# 覆盖单个标签最大可见字符数。
# MEME_MAX_TAG_LENGTH=20
# 覆盖 Meme 标题最大可见字符数。
# MEME_MAX_TITLE_LENGTH=60
